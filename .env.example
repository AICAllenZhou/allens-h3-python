# Allen's MiniMax H3 API — client configuration
#
# Copy to `.env` and fill in the two values you were given.
# Never commit the filled-in file.
#
# The SDK reads these from the environment; nothing is compiled into the
# package. The endpoint hostname can change, so always configure it here
# rather than hard-coding it in your code.

ALLENS_H3_BASE_URL=
ALLENS_H3_API_KEY=
