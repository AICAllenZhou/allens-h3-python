            ]
          }
        },
        "example": {
          "job_id": "job_7f2a91c4",
          "status": "cancelling"
        }
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
