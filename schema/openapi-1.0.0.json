{
  "openapi": "3.1.0",
  "info": {
    "title": "Allen's MiniMax H3 API",
    "description": "Text-to-video generation on a private RTX 3090 workstation.\n\n**This is a credential-protected private service.** There is no public sign-up and no anonymous access. The host is reachable only through an operator-managed tunnel whose hostname changes between restarts, so clients must configure `ALLENS_H3_BASE_URL` themselves — no endpoint is ever hardcoded in the SDK.\n\n### Authentication\n`Authorization: Bearer <client_id>:<secret>`\n\n### Scopes\n- `read` — inspect GPU telemetry, list and poll your own jobs, download your own finished videos.\n- `generate` — submit and cancel jobs.\n\nA credential carries a comma-separated scope set (commonly `generate,read`). A `read`-only credential receives `403` on any generating route.\n\n### Isolation\nJobs are strictly per-client. A job belonging to another client is indistinguishable from one that does not exist — both return `404`.\n\n### Schema provenance\nThe production server runs with `openapi_url=None`, `docs_url=None` and `redoc_url=None`. This document is generated offline from the live application object and shipped with the SDK; the server itself never exposes it.",
    "version": "1.0.0",
    "x-sdk-version": "1.0.0",
    "contact": {
      "name": "Allen Zhou",
      "url": "https://github.com/AICAllenZhou/allens-h3-python"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/AICAllenZhou/allens-h3-python/blob/main/LICENSE"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "description": "The only unauthenticated route. Deliberately returns no hostnames, versions or filesystem paths.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service reachable. `status` is 'degraded' when ComfyUI or the GPU is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/gpu": {
      "get": {
        "summary": "GPU telemetry",
        "operationId": "getGpu",
        "responses": {
          "200": {
            "description": "Live telemetry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GPUStatus"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or invalid credential. Every failure mode returns an identical body so the API cannot be used as a credential oracle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "unauthorized",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the credential lacks the required scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "forbidden",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "429": {
            "description": "Per-client rate limit exceeded. Retry-After header is set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "client rate limit exceeded",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "503": {
            "description": "GPU not available to the driver.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "service unavailable",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "read"
      }
    },
    "/v1/videos": {
      "post": {
        "summary": "Submit a generation job",
        "operationId": "createVideo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Job queued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "bad request",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or invalid credential. Every failure mode returns an identical body so the API cannot be used as a credential oracle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "unauthorized",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the credential lacks the required scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "forbidden",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "429": {
            "description": "Per-client rate limit exceeded. Retry-After header is set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "client rate limit exceeded",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "409": {
            "description": "Per-client queue depth exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "too many queued jobs",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "413": {
            "description": "Body larger than 16384 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "payload too large",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "422": {
            "description": "Parameter failed validation — dimensions out of range or not a multiple of 32, duration/steps out of range, or an unknown field was supplied (extra fields are rejected).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "width must be a multiple of 32",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "503": {
            "description": "ComfyUI offline, or the GPU safety gate blocked the start.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "service unavailable",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Returns `202` immediately; generation is asynchronous. Poll `GET /v1/jobs/{job_id}` until the status is terminal, then fetch the video.\n\nRejected with `503` when ComfyUI is down or the GPU thermal/power gate considers it unsafe to start work.",
        "x-required-scope": "generate"
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "summary": "Poll one job",
        "operationId": "getJob",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current state. `video_url` appears once the job completes; `error` only on failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or invalid credential. Every failure mode returns an identical body so the API cannot be used as a credential oracle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "unauthorized",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the credential lacks the required scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "forbidden",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "429": {
            "description": "Per-client rate limit exceeded. Retry-After header is set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "client rate limit exceeded",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job, or a job owned by another client. The two cases are intentionally indistinguishable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "not found",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          }
        },
        "x-required-scope": "read"
      }
    },
    "/v1/jobs": {
      "get": {
        "summary": "List your recent jobs",
        "operationId": "listJobs",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Limit",
              "minimum": 1,
              "maximum": 100
            },
            "description": "Clamped server-side to 1-100."
          }
        ],
        "responses": {
          "200": {
            "description": "Most recent first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or invalid credential. Every failure mode returns an identical body so the API cannot be used as a credential oracle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "unauthorized",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the credential lacks the required scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "forbidden",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "429": {
            "description": "Per-client rate limit exceeded. Retry-After header is set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "client rate limit exceeded",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          }
        },
        "description": "Scoped to the calling credential. Other clients' jobs are never returned.",
        "x-required-scope": "read"
      }
    },
    "/v1/jobs/{job_id}/video": {
