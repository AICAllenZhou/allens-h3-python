              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or invalid credential. Every failure mode returns an identical body so the API cannot be used as a credential oracle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "unauthorized",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the credential lacks the required scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "forbidden",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "429": {
            "description": "Per-client rate limit exceeded. Retry-After header is set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "client rate limit exceeded",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job, foreign job, or the file is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "not found",
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "409": {
            "description": "Job has not completed yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "detail": "job is generating",
                  "request_id": "a1b2c3d4e5f6"
                }
